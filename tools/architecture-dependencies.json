{
  "rust": {
    "lino-document": {
      "path": "crates/document",
      "allow": [],
      "platform_dependencies": false,
      "forbid": [
        "tokio",
        "async-std",
        "smol",
        "reqwest",
        "sqlx",
        "rusqlite",
        "notify",
        "serde",
        "serde_json"
      ]
    },
    "lino-markdown": {
      "path": "crates/markdown",
      "allow": [
        "lino-document"
      ],
      "platform_dependencies": false,
      "forbid": [
        "tokio",
        "async-std",
        "smol",
        "reqwest",
        "sqlx",
        "rusqlite",
        "notify"
      ]
    },
    "lino-application": {
      "path": "crates/application",
      "allow": [
        "lino-document",
        "lino-markdown"
      ],
      "platform_dependencies": false,
      "forbid": [
        "tokio",
        "async-std",
        "smol",
        "reqwest",
        "sqlx",
        "rusqlite",
        "notify",
        "serde",
        "serde_json"
      ]
    },
    "lino-adapters": {
      "path": "crates/adapters",
      "allow": [
        "lino-document",
        "lino-application"
      ],
      "platform_dependencies": true
    },
    "lino-protocol": {
      "path": "crates/protocol",
      "allow": [
        "lino-document"
      ],
      "platform_dependencies": false,
      "forbid": [
        "tokio",
        "async-std",
        "smol",
        "reqwest",
        "sqlx",
        "rusqlite",
        "notify"
      ]
    },
    "lino-runtime": {
      "path": "crates/runtime",
      "allow": [
        "lino-document",
        "lino-application",
        "lino-adapters",
        "lino-protocol"
      ],
      "platform_dependencies": false
    },
    "lino-ffi": {
      "path": "crates/ffi",
      "allow": [
        "lino-runtime",
        "lino-protocol"
      ],
      "platform_dependencies": false
    }
  },
  "frontend": {
    "@lino/editor": {
      "path": "packages/editor",
      "allow": [
        "@lino/protocol"
      ]
    },
    "@lino/protocol": {
      "path": "packages/protocol",
      "allow": []
    }
  },
  "platform_packages": [
    "tauri",
    "wry",
    "gtk",
    "gtk4",
    "webkit2gtk",
    "webkit6",
    "windows",
    "windows-sys",
    "objc2",
    "objc2-app-kit",
    "objc2-web-kit",
    "cocoa"
  ]
}
