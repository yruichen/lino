{
  "name": "lino",
  "version": "0.0.3",
  "private": true,
  "description": "A file-first editor with a native shell and shared Rust services, starting with Markdown.",
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "npm run build --workspace @lino/editor",
    "check": "npm run check:architecture && npm run editor:check",
    "check:architecture": "node tools/check-architecture.cjs",
    "editor:check": "npm run typecheck --workspace @lino/editor && node --test tests/editor/*.test.mts",
    "app:build": "node tools/macos/build.cjs",
    "app:verify": "node tools/macos/verify.cjs",
    "app:verify:navigation": "node tools/macos/verify.cjs --navigation",
    "macos:check": "node tools/macos/check.cjs",
    "protocol:generate": "node tools/protocol/types.cjs",
    "protocol:check": "node tools/protocol/types.cjs --check"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "jsdom": "30.1.2"
  },
  "workspaces": [
    "packages/editor",
    "packages/protocol"
  ]
}
